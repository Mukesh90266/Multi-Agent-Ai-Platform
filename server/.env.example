# Copy to server/.env and fill values

PORT=5000

# Required for real LLM agent responses (not offline fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional MongoDB history
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/multi_agent_platform

# Optional live web search (highly recommended for web_search tool)
# Free tiers: https://serper.dev  or  https://brave.com/search/api/
# SERPER_API_KEY=your_serper_key
# BRAVE_API_KEY=your_brave_key
