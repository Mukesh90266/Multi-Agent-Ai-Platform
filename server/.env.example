# ============================================
# Multi-Agent AI Platform — Server Config
# ============================================
# Copy this file as .env and fill in your values:
#   cp .env.example .env

# ── Server ──
PORT=5000

# ── MongoDB ──
# Option A: MongoDB Atlas with SRV (auto-discovery) — may fail if DNS SRV is blocked
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/multi-agent-pipeline?retryWrites=true&w=majority
#
# Option B: MongoDB Atlas with STANDARD connection (use if SRV fails)
#   Get this from: Atlas Dashboard → Connect → Drivers → Connection String
#   Replace <password> and remove brackets. URL-encode special chars in password (@→%40, #→%23)
# MONGODB_URI=mongodb://<username>:<password>@ac-xxxxx-shard-00-00.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-01.xxxxx.mongodb.net:27017,ac-xxxxx-shard-00-02.xxxxx.mongodb.net:27017/multi-agent-pipeline?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Option C: Local MongoDB
# MONGODB_URI=mongodb://127.0.0.1:27017/multi-agent-pipeline

# ── Groq API (LLM) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
