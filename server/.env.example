# ============================================
# Multi-Agent AI Platform — Server Config
# ============================================
# Copy this file as .env and fill in your values:
#   cp .env.example .env

# ── Server ──
PORT=5000

# ── MongoDB ──
# For MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/multi-agent-pipeline?retryWrites=true&w=majority
#
# For local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/multi-agent-pipeline

# ── Groq API (LLM) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
